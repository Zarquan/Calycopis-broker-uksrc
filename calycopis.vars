#
# Environment variables for the Calycopis deployment
#
#CALYCOPIS_DEV_NAME=calycopis-dev

CALYCOPIS_POD_NAME=calycopis-pod
CALYCOPIS_NET_NAME=calycopis-network

CALYCOPIS_TOOLS_CONTAINER_NAME=calycopis-tools
CALYCOPIS_TOOLS_CONTAINER_IMAGE=ghcr.io/ivoa/calycopis/developer-tools:2026.09.17

CALYCOPIS_BROKER_OPT=/opt/calycopis
CALYCOPIS_BROKER_CODE=/opt/calycopis
CALYCOPIS_BROKER_LOGS=/var/calycopis/log
CALYCOPIS_BROKER_LOGS_VOLUME=calycopis-broker-logs
CALYCOPIS_BROKER_CONFIG_PATH=/etc/calycopis
CALYCOPIS_BROKER_CONFIG_VOLUME=calycopis-broker-config
CALYCOPIS_BROKER_HOSTNAME=calycopis-broker
CALYCOPIS_BROKER_CONTAINER_NAME=calycopis-broker
CALYCOPIS_BROKER_CONTAINER_IMAGE=localhost/calycopis/calycopis-broker:latest
CALYCOPIS_BROKER_INTERNAL_PORT=8082
CALYCOPIS_BROKER_EXTERNAL_PORT=8082

CALYCOPIS_DATABASE_PORT=5432
CALYCOPIS_DATABASE_CONFIG_PATH=/etc/postgres
CALYCOPIS_DATABASE_CONFIG_VOLUME=calycopis-database-config
CALYCOPIS_DATABASE_NAME=calycopis-db-name
CALYCOPIS_DATABASE_HOSTNAME=calycopis-database
CALYCOPIS_DATABASE_CONTAINER_NAME=calycopis-database
CALYCOPIS_DATABASE_CONTAINER_IMAGE=docker.io/library/postgres:18.6

CALYCOPIS_TEST_DATA_PATH=/var/calycopis/data
CALYCOPIS_TEST_DATA_VOLUME=calycopis-testdata

