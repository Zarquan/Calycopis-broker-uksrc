#
# Environment variables for the Calycopis deployment.
#
# The in-container mirror of the host platform's "${HOME}/calycopis.env",
# giving the location of each source clone at the container's mount paths.
# This file answers "where is the source"; "calycopis.vars" answers "where
# are the deployed services".
#
# The paths must match the volume mounts and the matching --env values of
# the `podman run` command that launched the container, so they change as
# the deployment evolves. A variable can be set even where its volume is not
# mounted in this instance. See the 'Container paths and environment
# variables' section of AGENTS.md.
#

CALYCOPIS_ROOT=/Calycopis
CALYCOPIS_HOME=/Calycopis/Calycopis-broker
CALYCOPIS_CODE=/Calycopis/Calycopis-broker

TREBULA_CODE=/Calycopis/Calycopis-openapi
ISOBEON_CODE=/Calycopis/Calycopis-Isobeon

# A durable scratch area for agents, mounted at a path inside the workspace root
# so that agent shells can write to it. It survives a container restart, unlike
# /tmp, and it sits outside both repositories, so nothing written there can be
# committed by accident. It is not version controlled and not backed up.
#
CALYCOPIS_SCRATCH=/Calycopis/agents/scratch

