<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>net.ivoa.calycopis</groupId>
    <artifactId>calycopis-broker</artifactId>
    <version>1.0.7-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Calycopis broker webapp</name>
    <description>IVOA ExecutionBroker Spring Boot implementation</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <!--+
            | Enable annotation processing in the compiler.
            | https://stackoverflow.com/a/79367717
            | https://maven.apache.org/plugins/maven-compiler-plugin/compile-mojo.html#proc
            | Starting with JDK 21, this option must be set explicitly.
            +-->
        <maven.compiler.proc>full</maven.compiler.proc>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>

        <repository>
            <id>nexus-uksrc</id>
            <name>IVOA packages in the UKSRC Nexus</name>
            <url>https://repo.dev.uksrc.org/repository/maven-public/</url>
            <snapshots>
              <enabled>true</enabled>
            </snapshots>
        </repository>

        <!--+
            | This requires a personal access token with package:read
            | permissions in the user's ~/m2/settings.xml file.
            | https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-apache-maven-registry#installing-a-package
            | https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-apache-maven-registry#authenticating-to-github-packages
        <repository>
            <id>github-ivoa</id>
            <name>IVOA packages on GitHub</name>
            <url>https://maven.pkg.github.com/ivoa/*</url>
            <snapshots>
              <enabled>true</enabled>
            </snapshots>
        </repository>
            +-->
        <!--+
            | This embeds a personal access token with package:read
            | permissions in the repository URL.
            | https://github.com/orgs/community/discussions/25629#discussioncomment-3248525
            | If we want to do this, we should create a separate machine
            | account with read-only access to IVOA projects.
            | https://docs.github.com/en/authentication/connecting-to-github-with-ssh/managing-deploy-keys#machine-users
        <repository>
            <id>github-public</id>
            <url>https://public:&#103;####################@maven.pkg.github.com/ivoa/*</url>
            <snapshots>
              <enabled>true</enabled>
            </snapshots>
        </repository>
            +-->
    </repositories>

    <dependencies>
        <!--+
            | Include the Spring Boot classes generated from the schema.
            | https://github.com/Zarquan/Calycopis-schema
            +-->
        <dependency>
            <groupId>net.ivoa.calycopis</groupId>
            <artifactId>calycopis-openapi-spring</artifactId>
            <version>1.0.7-SNAPSHOT</version>
        </dependency>

        <!--+
            | Include our generated Skaha client.
        <dependency>
            <groupId>net.ivoa.calycopis</groupId>
            <artifactId>skaha-client</artifactId>
            <version>0.1-SNAPSHOT</version>
        </dependency>
            +-->

        <!--+
            | GitHub UUID generator.
            +-->
        <dependency>
          <groupId>com.github.f4b6a3</groupId>
          <artifactId>uuid-creator</artifactId>
          <version>6.1.1</version>
        </dependency>

        <!--+
            | Embedded H2 database.
            | https://www.baeldung.com/spring-boot-h2-database
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
            +-->

        <!--+
            | ThreeTen time classes.
            | https://github.com/ThreeTen/threeten-extra
            +-->
        <dependency>
          <groupId>org.threeten</groupId>
          <artifactId>threeten-extra</artifactId>
          <version>1.8.0</version>
        </dependency>

        <!--+
            | Add slf4j and log4j logging.
            | https://www.baeldung.com/java-logging-intro
            | (versions are managed by SpringBoot)
            +-->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>

        <!--+
            | Exclude default logging from SpringBoot.
            | https://stackoverflow.com/a/61873064
            +-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!--+
            | Project Lombok
            | https://projectlombok.org/
            +-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <!--version>${lombok.version}</version-->
            <scope>provided</scope>
        </dependency>

        <!--+
            | Java Servlet
            | https://stackoverflow.com/a/76034931
            +-->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.14.0</version>
        </dependency>

        <dependency>
            <groupId>wtf.metio.storage-units</groupId>
            <artifactId>storage-units-model</artifactId>
            <version>2025.8.6</version>
        </dependency>

        <!--+
            | Spring Security and OAuth2 Resource Server.
            | (versions are managed by SpringBoot)
            +-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--+
            | Spring dependencies.
            | (versions are managed by SpringBoot)
            +-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--+
            | Jackson annotations.
            | (versions are managed by SpringBoot)
            +-->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!--+
            | Added springdoc-openapi to generate OpenAPI spec.
            | https://stackoverflow.com/questions/55938207/how-to-generate-openapi-3-0-spec-from-existing-spring-boot-app
            | https://www.baeldung.com/spring-rest-openapi-documentation
            | Fails due to an incompatible version issue.
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>
            +-->

        <!--+
            | PostgreSQL JDBC driver
            +-->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.8</version>
        </dependency>

        <!--+
            | Docker Java client library.
            | https://github.com/docker-java/docker-java
            +-->
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-core</artifactId>
            <version>3.4.1</version>
        </dependency>
        <dependency>
            <groupId>com.github.docker-java</groupId>
            <artifactId>docker-java-transport-zerodep</artifactId>
            <version>3.4.1</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--+
                    | https://docs.spring.io/spring-boot/maven-plugin/build-image.html
                    +-->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <docker>
                        <host>${env.CONTAINER_HOST}</host>
                        <bindHostToBuilder>true</bindHostToBuilder>
                    </docker>
                    <image>
                        <!--+
                            | https://github.com/orgs/paketo-buildpacks/discussions/314#discussioncomment-10939537
                            +-->
                        <builder>paketobuildpacks/builder-jammy-base:0.4.621</builder>
                        <!--name>ghcr.io/uksrc/calycopis/${project.artifactId}:${project.version}</name-->
                        <!--name>localhost/calycopis/${project.artifactId}:${project.version}</name-->
                        <name>${project.artifactId}:${project.version}</name>
                        <!--spring-boot.build-image.runImage></spring-boot.build-image.runImage-->
                        <tags>
                            <tag>localhost/calycopis/${project.artifactId}:latest</tag>
                            <tag>localhost/calycopis/${project.artifactId}:${project.version}</tag>
                            <tag>images.dev.uksrc.org/calycopis/${project.artifactId}:latest</tag>
                            <tag>images.dev.uksrc.org/calycopis/${project.artifactId}:${project.version}</tag>
                            <!--+
                            <tag>ghcr.io/uksrc/calycopis/${project.artifactId}:latest</tag>
                            <tag>ghcr.io/uksrc/calycopis/${project.artifactId}:${project.version}</tag>
                            <tag>ghcr.io/ivoa/calycopis/${project.artifactId}:latest</tag>
                            <tag>ghcr.io/ivoa/calycopis/${project.artifactId}:${project.version}</tag>
                                +-->
                        </tags>
                        <!--+
                            | https://stackoverflow.com/questions/62865594/spring-boot-2-3-0-buildpack-builds-image-with-creation-date-40-years-ago
                            | https://stackoverflow.com/a/78096200
                            +-->
                        <createdDate>${maven.build.timestamp}</createdDate>
                    </image>
                </configuration>
                <!--+
                    | Remove the automatic execution.
                    | Gives us separate commands for creating the jar and creating the container.
                <executions>
                    <execution>
                        <goals>
                            <goal>build-image-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
                    +-->
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ivoa-profile</id>
            <distributionManagement>
                <repository>
                    <id>ivoa-github</id>
                    <name>IVOA GitHub Packages</name>
                    <url>https://maven.pkg.github.com/ivoa/Calycopis-openapi</url>
                </repository>
                <snapshotRepository>
                    <id>ivoa-github</id>
                    <name>IVOA GitHub Snapshots</name>
                    <url>https://maven.pkg.github.com/ivoa/Calycopis-openapi</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
        <profile>
            <id>uksrc-profile</id>
            <distributionManagement>
                <repository>
                    <id>uksrc-nexus</id>
                    <url>https://repo.dev.uksrc.org/repository/maven-releases/</url>
                </repository>
                <snapshotRepository>
                    <id>uksrc-nexus</id>
                    <url>https://repo.dev.uksrc.org/repository/maven-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>
